        footer p {
            margin-bottom: 0.5rem;
        }

        footer a {
            color: var(--accent);
            text-decoration: none;
        }

        /* Responsive */
        @media (max-width: 768px) {
            .nav {
                flex-wrap: wrap;
            }

            .nav-toggle {
                display: inline-flex;
            }

            .nav-links {
                display: none;
                width: 100%;
                flex-direction: column;
                align-items: flex-start;
                gap: 0.9rem;
                padding: 1rem 0 0.25rem;
            }

            .nav-links.is-open {
                display: flex;
            }

            .nav .cta-btn {
                display: none;
            }

            .about-content,
            .contact-grid {
                grid-template-columns: 1fr;
            }

            .about-image {
                height: 220px;
                order: -1;
            }

            .hero {
                padding: 3.5rem 0 4.5rem;
            }

            .logo {
                font-size: 1.15rem;
            }
        }
    </style>
</head>
